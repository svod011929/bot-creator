# Names only. Copy to a private .env and fill in locally. Never commit values,
# never put tokens, keys or webhook secrets in this repository or in chat.
BOT_TOKEN=
ADMIN_IDS=
CHAT_URL=
CHANNEL_URL=
ADMIN_URL=
DATA_DIR=
LAUNCH_DATE=
LOG_LEVEL=
PRICE_CLICKER=
PRICE_REFBOT=
PRICE_STARBOT=
PRICE_MICROTASKS=
HOSTING_DAY_PRICE=
START_HOSTING_DAYS=
VIP_PRICE=
REF_PERCENT=
RESALE_FEE_PERCENT=
LAVEPAY_API_KEY=
LAVEPAY_BASE_URL=
LAVEPAY_WEBHOOK_SECRET=
LAVEPAY_WEBHOOK_HOST=
LAVEPAY_WEBHOOK_PORT=
TGRASS_FACTORY_TOKEN=
TGRASS_OWNER_ID=
TGRASS_OWNER_USERNAME=
TGRASS_HUB_API_KEY=
TGRASS_BASE_URL=
TGRASS_REWARD=
TGRASS_MIN_USERS=
PIARFLOW_TOKEN=
PIARFLOW_HUB_API_KEY=
PIARFLOW_BASE_URL=
PIARFLOW_REWARD=
PIARFLOW_MIN_USERS=
WITHDRAW_APPROVER_ID=
WITHDRAW_METHODS=
# Global switch for owner-shop LavePay payouts in clicker/refbot. Code default is off.
# Set to 1 on the server. A bot is live only after the owner connects their own LavePay shop.
# Auto-pay stays off. No platform fee or daily cap. Method: USDT TRC-20 only.
CHILD_LAVEPAY_PAYOUTS=
CHILD_LAVEPAY_PAYOUTS_AUTO=
CHILD_LAVEPAY_DAILY_LIMIT_RUB=
# Fernet key for encrypting owner LavePay API keys at rest. Leave empty to auto-create data/.owner_payout_key.
OWNER_PAYOUT_KEY=
WEBHOOK_PUBLIC_BASE=
WEBHOOK_LISTEN_HOST=
WEBHOOK_LISTEN_PORT=

# Child bots: process (default, one OS process per bot) or shared (one worker process).
CHILD_RUNTIME=
