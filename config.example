# Copy the needed fields to a private .env; never commit credentials.
BOT_TOKEN=
ADMIN_IDS=
DATA_DIR=data
TGRASS_FACTORY_TOKEN=
TGRASS_OWNER_ID=
TGRASS_OWNER_USERNAME=
TGRASS_HUB_API_KEY=
PIARFLOW_TOKEN=
PIARFLOW_HUB_API_KEY=
LAVEPAY_API_KEY=
LAVEPAY_WEBHOOK_SECRET=

# Withdrawals of earned money (manual payouts)
# Telegram ID of the single approver; empty = the only ADMIN_IDS entry (if exactly one)
WITHDRAW_APPROVER_ID=
# Comma list of: card,sbp,usdt_trc20 (empty = all)
WITHDRAW_METHODS=
# WITHDRAW_MIN (kopecks, default 10000) and WITHDRAW_FEE_PERCENT (default 5) are also editable in admin prices

# Unsubscribe webhooks (TGrass / PiarFlow). Secrets are stored in the private DB, not here.
# Public origin shown to owners/admins; Caddy should proxy /webhooks/* to the local listener.
WEBHOOK_PUBLIC_BASE=https://bnbb.tech
WEBHOOK_LISTEN_HOST=127.0.0.1
WEBHOOK_LISTEN_PORT=8787
